{
  "name": "universal-card-battles",
  "private": true,
  "type": "module",
  "imports": {
    "#engine": "./packages/engine/src/index.ts",
    "#ai": "./packages/ai/src/index.ts",
    "#harness": "./packages/test-harness/src/index.ts",
    "#sdk": "./packages/module-sdk/src/index.ts",
    "#sdk/node": "./packages/module-sdk/src/node.ts",
    "#campaign": "./packages/campaign/src/index.ts",
    "#maker": "./packages/maker/src/index.ts"
  },
  "scripts": {
    "test": "node --test --test-reporter=dot \"packages/*/tests/*.test.ts\"",
    "typecheck": "tsc -p . --pretty false",
    "sim": "node packages/test-harness/src/sim.ts",
    "check": "npm run -s typecheck && npm test -s",
    "validate": "node packages/module-sdk/src/cli.ts validate",
    "pack": "node packages/module-sdk/src/cli.ts pack",
    "events": "node packages/test-harness/src/events.ts",
    "golden": "node packages/test-harness/src/golden.ts",
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "e2e": "npm run -s build -- --logLevel warn && node apps/web/e2e.mjs",
    "tourney": "node packages/test-harness/src/tourney.ts",
    "bench": "node packages/test-harness/src/bench.ts",
    "modules": "node packages/test-harness/src/modules.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9",
    "vite": "^6.4.6"
  }
}
