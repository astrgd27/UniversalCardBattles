[
  {"id": "ember-adept", "name": "Ember Adept", "type": "unit", "cost": 1, "power": 1, "health": 1, "keywords": ["channeler"],
    "text": "Channel (exhaust, fast): deal 1 damage to any target.",
    "targets": [{"as": "$t", "prompt": "target", "from": ["concat", ["players"], ["filter", ["cards", "*", "board"], ["=", ["get", "$it", "type"], "unit"]]]}],
    "channel": [["damage", "$t", 1, "$self"]]},
  {"id": "wardstone-golem", "name": "Wardstone Golem", "type": "unit", "cost": 3, "power": 2, "health": 4, "text": "Enter: gains 2 ward.",
    "abilities": [{"on": "enter", "text": "gains 2 ward", "do": [["inc", "$self", "ward", 2]]}]},
  {"id": "grove-herald", "name": "Grove Herald", "type": "unit", "cost": 2, "power": 2, "health": 2, "text": "Whenever another unit enters under your control, gain 1 life.",
    "abilities": [{"on": "moved", "text": "gain 1 life",
      "if": ["and", ["=", "$e.to", "board"], ["=", "$e.toPlayer", "$me"], ["!=", "$e.newObj", "$self"], ["=", ["get", "$e.newObj", "type"], "unit"]],
      "do": [["inc", "$me", "life", 1]]}]},
  {"id": "banner-bearer", "name": "Banner Bearer", "type": "unit", "cost": 2, "power": 1, "health": 2, "text": "Your other units get +1 power.",
    "statics": [{"layer": "add", "affects": ["filter", ["cards", "$me", "board"], ["and", ["=", ["get", "$it", "type"], "unit"], ["!=", "$it", "$self"]]],
      "mods": [{"op": "add", "stat": "power", "value": 1}]}]},
  {"id": "mantle-warden", "name": "Mantle Warden", "type": "unit", "cost": 3, "power": 2, "health": 3, "text": "Your units with 3 or more power get +1 health.",
    "statics": [{"layer": "add", "affects": ["filter", ["cards", "$me", "board"], ["and", ["=", ["get", "$it", "type"], "unit"], [">=", ["get", "$it", "power"], 3]]],
      "mods": [{"op": "add", "stat": "health", "value": 1}]}]},
  {"id": "grove-hulk", "name": "Grove Hulk", "type": "unit", "cost": 4, "power": 3, "health": 5, "keywords": ["guard"], "text": "Guard"},
  {"id": "swiftblade", "name": "Swiftblade", "type": "unit", "cost": 2, "power": 2, "health": 1, "keywords": ["haste"], "text": "Haste"},
  {"id": "seedling", "name": "Seedling", "type": "unit", "cost": 1, "power": 0, "health": 1, "text": "Enter: put a growth counter on a unit you control.",
    "abilities": [{"on": "enter", "text": "growth counter", "do": [
      ["choose", {"from": ["filter", ["cards", "$me", "board"], ["=", ["get", "$it", "type"], "unit"]], "as": "$u", "prompt": "Put a growth counter on"}],
      ["inc", "$u", "growth", 1]]}]},
  {"id": "storm-drake", "name": "Storm Drake", "type": "unit", "cost": 5, "power": 4, "health": 4, "text": "Enemy units get -1 power.",
    "statics": [{"layer": "add", "affects": ["filter", ["cards", "$opp", "board"], ["=", ["get", "$it", "type"], "unit"]], "mods": [{"op": "add", "stat": "power", "value": -1}]}]},
  {"id": "mirror-sentinel", "name": "Mirror Sentinel", "type": "unit", "cost": 3, "power": 2, "health": 3, "text": "Damage dealt to this is reduced by 1.",
    "replacements": [{"replace": "damage", "text": "reduce by 1", "if": ["=", "$e.target", "$self"], "modify": {"amount": ["max", 0, ["-", "$e.amount", 1]]}}]},
  {"id": "arc-bolt", "name": "Arc Bolt", "type": "spell", "cost": 1, "keywords": ["fast"], "text": "Fast. Deal 2 damage to any target.",
    "targets": [{"as": "$t", "prompt": "target", "from": ["concat", ["players"], ["filter", ["cards", "*", "board"], ["=", ["get", "$it", "type"], "unit"]]]}],
    "effects": [["damage", "$t", 2, "$self"]]},
  {"id": "hush", "name": "Hush", "type": "spell", "cost": 2, "keywords": ["fast"], "text": "Fast. Counter target spell or ability an opponent controls.",
    "targets": [{"as": "$t", "prompt": "spell or ability", "from": ["filter", ["stack"], ["!=", ["get", "$it", "controller"], "$me"]]}],
    "effects": [["counter", "$t"]]},
  {"id": "wither", "name": "Wither", "type": "spell", "cost": 1, "keywords": ["fast"], "text": "Fast. Target unit gets -3 power until end of turn.",
    "targets": [{"as": "$t", "prompt": "unit", "from": ["filter", ["cards", "*", "board"], ["=", ["get", "$it", "type"], "unit"]]}],
    "effects": [["modify", "$t", {"layer": "add", "until": "turn", "mods": [{"op": "add", "stat": "power", "value": -3}]}]]},
  {"id": "growth-surge", "name": "Growth Surge", "type": "spell", "cost": 2, "keywords": ["fast"], "text": "Fast. Put two growth counters on target unit.",
    "targets": [{"as": "$t", "prompt": "unit", "from": ["filter", ["cards", "*", "board"], ["=", ["get", "$it", "type"], "unit"]]}],
    "effects": [["inc", "$t", "growth", 2]]},
  {"id": "hexing-gaze", "name": "Hexing Gaze", "type": "spell", "cost": 2, "text": "Until end of turn, target unit has base power 1 and loses guard.",
    "targets": [{"as": "$t", "prompt": "unit", "from": ["filter", ["cards", "*", "board"], ["=", ["get", "$it", "type"], "unit"]]}],
    "effects": [["modify", "$t", {"layer": "set", "until": "turn", "mods": [{"op": "set", "stat": "power", "value": 1}, {"op": "remove", "kw": "guard"}]}]]},
  {"id": "pacify", "name": "Pacify", "type": "aura", "cost": 2, "text": "Bind to an enemy unit. It can't attack.",
    "targets": [{"as": "$t", "prompt": "enemy unit", "from": ["filter", ["cards", "$opp", "board"], ["=", ["get", "$it", "type"], "unit"]]}],
    "effects": [["move", "$self", "board", {"as": "$self"}], ["link", "$self", "bound", "$t"]],
    "statics": [{"layer": "add", "affects": ["get", "$self", "bound"], "mods": [{"op": "grant", "kw": "pacified"}]}]},
  {"id": "ward-sigil", "name": "Ward Sigil", "type": "spell", "cost": 1, "keywords": ["fast"], "text": "Fast. Target unit gains 1 ward.",
    "targets": [{"as": "$t", "prompt": "unit", "from": ["filter", ["cards", "*", "board"], ["=", ["get", "$it", "type"], "unit"]]}],
    "effects": [["inc", "$t", "ward", 1]]},
  {"id": "study", "name": "Study", "type": "spell", "cost": 2, "text": "Draw two cards.", "effects": [["draw", "$me", 2]]},
  {"id": "unmake", "name": "Unmake", "type": "spell", "cost": 4, "text": "Destroy target unit.",
    "targets": [{"as": "$t", "prompt": "unit", "from": ["filter", ["cards", "*", "board"], ["=", ["get", "$it", "type"], "unit"]]}],
    "effects": [["destroy", "$t"]]},
  {"id": "echo-of-kin", "name": "Echo of Kin", "type": "spell", "cost": 3, "text": "Return a unit card from your grave to your hand.",
    "targets": [{"as": "$t", "prompt": "unit in your grave", "from": ["filter", ["cards", "$me", "grave"], ["=", ["get", "$it", "type"], "unit"]]}],
    "effects": [["move", "$t", "hand"]]},
  {"id": "overcharge", "name": "Overcharge", "type": "spell", "cost": 2, "keywords": ["fast"], "text": "Fast. Gain 2 charge.", "effects": [["inc", "$me", "charge", 2]]}
]
