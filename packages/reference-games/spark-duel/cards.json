  {"id": "recall", "name": "Recall", "type": "spell", "cost": 2, "text": "Return a unit card from your grave to your hand.",
    "targets": [{"as": "$t", "prompt": "unit in your grave", "from": ["filter", ["cards", "$me", "grave"], ["=", ["get", "$it", "type"], "unit"]]}],
