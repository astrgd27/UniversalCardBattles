    "effects": [["damage", "$t", 2, "$self"]]},
  {"id": "mend", "name": "Mend", "type": "spell", "cost": 1, "text": "Gain 4 life.", "effects": [["inc", "$me", "life", 4]]},
  {"id": "insight", "name": "Insight", "type": "spell", "cost": 2, "text": "Draw two cards.", "effects": [["draw", "$me", 2]]},
  {"id": "rally", "name": "Rally", "type": "spell", "cost": 2, "text": "Your units get +1 power while they stay on the board.",
