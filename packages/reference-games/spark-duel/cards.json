      ["choose", {"who": "$me", "from": ["concat", ["players"], ["cards", "*", "board"]], "as": "$t", "prompt": "Deal 2 damage to"}],
      ["damage", "$t", 2, "$self"]]}]},
  {"id": "spark-bolt", "name": "Spark Bolt", "type": "spell", "cost": 1, "text": "Deal 2 damage to any target.",
